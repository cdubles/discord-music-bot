# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Discord (required) ---------------------------------------------------
# Bot token from https://discord.com/developers/applications -> Bot -> Token
DISCORD_TOKEN=
# Application ID from the General Information page
DISCORD_CLIENT_ID=
# Your server's ID (enable Developer Mode, right-click the server -> Copy ID).
# Slash commands register here instantly. Leave empty to register globally
# (takes up to an hour to propagate).
DISCORD_GUILD_ID=

# --- Behaviour ------------------------------------------------------------
# Fallback prefix for text commands; each guild can override it with /prefix.
DEFAULT_PREFIX=!
# Comma-separated user IDs allowed to run owner-only commands.
OWNER_IDS=

# --- Runtime --------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug
DB_PATH=/app/data/bot.db

# --- Binaries (paths inside the container) --------------------------------
FFMPEG_PATH=/usr/bin/ffmpeg
YTDLP_PATH=/usr/local/bin/yt-dlp

# --- Playback -------------------------------------------------------------
# Seconds alone or idle in a voice channel before the bot disconnects.
IDLE_TIMEOUT_SECONDS=300
DEFAULT_VOLUME=50
MAX_QUEUE_SIZE=1000
MAX_PLAYLIST_IMPORT=200

# --- YouTube access -------------------------------------------------------
# Optional. Netscape-format cookie file, placed on the data volume so it can be
# refreshed without rebuilding. Use a THROWAWAY Google account — yt-dlp traffic
# can get an account flagged. Needed mainly when running from a datacenter IP.
YTDLP_COOKIES_FILE=
# Optional escape hatch if YouTube blocks the host's IP entirely.
YTDLP_PROXY=
