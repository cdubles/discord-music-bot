{
  "name": "discord-music-bot",
  "version": "1.0.0",
  "description": "A radio for Discord voice channels: search, queue and play YouTube audio.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon --watch src --ext js,json,sql src/index.js",
    "deploy:commands": "node scripts/deploy-commands.js",
    "clear:commands": "node scripts/clear-commands.js",
    "docker:build": "docker compose build",
    "docker:dev": "docker compose up",
    "docker:sh": "docker compose run --rm bot sh",
    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.27.0",
    "dotenv": "^16.4.7",
    "pino": "^9.6.0",
    "sodium-native": "^5.1.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "pino-pretty": "^13.0.0"
  }
}
